# Copy to .env and fill in the two API keys:  cp .env.example .env
#
# One block per printer. The letter after PRINTER_ is the printer's id (a, b, …)
# and must stay the same once you've saved results, because results are stored
# under it.
#
# URL: how the calbench container reaches that OctoPrint. Both OctoPrint
# containers publish ports on CT 203, so go through the host. compose.yaml maps
# host.docker.internal to CT 203's Docker bridge gateway.
#
# KEY: in that OctoPrint instance → Settings → Application Keys → generate one
# named "calbench". Each instance has its own keys.
#
# MODEL: written into every file as M862.3 P "<model>", the firmware's printer
# model check. It must match what the printer reports or it warns (or refuses,
# depending on its check setting). To confirm, slice anything in PrusaSlicer
# with that printer's profile and copy the M862.3 line from the first few lines.

# --- Printer A: MK3S, standalone (octoprint-a, host port 80)
PRINTER_A_NAME=MK3S
PRINTER_A_URL=http://host.docker.internal:80
PRINTER_A_KEY=
PRINTER_A_MODEL=MK3S
PRINTER_A_MMU=false
PRINTER_A_ENCLOSED=false

# --- Printer B: MK3S+ with MMU3, in a PrusaBox (octoprint-b, host port 5001)
PRINTER_B_NAME=MK3S+ MMU3
PRINTER_B_URL=http://host.docker.internal:5001
PRINTER_B_KEY=
PRINTER_B_MODEL=MK3SMMU3
PRINTER_B_MMU=true
PRINTER_B_ENCLOSED=true

# Folder inside each OctoPrint's file list that test prints are uploaded into.
OCTOPRINT_FOLDER=calibration

# Set to false to allow uploads but never let this page start a print.
ALLOW_PRINT=true
